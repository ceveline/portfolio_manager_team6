# Database Configuration
# Option 1: Use DATABASE_URL (recommended)
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/portfolio_manager

# Option 2: Use individual MySQL environment variables (alternative)
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DB=portfolio_manager
# MYSQL_SOCKET=/tmp/mysql.sock  # Optional, for Unix socket connection
